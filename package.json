{
  "name": "tuneshift",
  "private": true,
  "version": "0.1.0",
  "description": "Personal music app with a live Sound Lab (web/PWA, Windows desktop, browser extension).",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tuneshift/web dev",
    "build": "pnpm --filter @tuneshift/web build",
    "preview": "pnpm --filter @tuneshift/web preview",
    "typecheck": "pnpm -r --workspace-concurrency=4 typecheck && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm build && pnpm --filter @tuneshift/extension build && playwright test",
    "e2e:only": "playwright test",
    "ext:build": "pnpm --filter @tuneshift/extension build && tsx scripts/zip-extension.ts",
    "desktop:dev": "pnpm --filter @tuneshift/desktop dev",
    "desktop:build": "pnpm --filter @tuneshift/desktop build",
    "desktop:icons": "pnpm --filter @tuneshift/desktop icons",
    "demo:make": "tsx scripts/make-demo-tracks.ts",
    "fixtures:make": "tsx scripts/make-test-fixtures.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@breezystack/lamejs": "1.2.7",
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "fflate": "0.8.3",
    "globals": "17.14.0",
    "libpg-query": "18.2.4",
    "msw": "3.0.7",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
