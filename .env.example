# Copy to .env.local (gitignored). Every key is OPTIONAL: the app builds, runs and passes
# all tests with none of them. Keys can also be pasted at runtime in Settings.
# Only PUBLIC keys belong here — never a Supabase service-role key or any secret.

# Audius works without a key (app_name=Tuneshift). An API key only raises rate limits.
VITE_AUDIUS_API_KEY=

# Jamendo client_id from https://devportal.jamendo.com (free, non-commercial).
VITE_JAMENDO_CLIENT_ID=

# Supabase project (friends, sync, sharing, parties). Use the anon/publishable key ONLY.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL used for share links and auth redirects.
VITE_PUBLIC_SITE_URL=https://malikmohamedgamer-bit.github.io/tuneshift/
